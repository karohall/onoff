<!DOCTYPE html>
<html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
html,body{margin:0;height:100%;background:transparent;overflow:hidden;}
canvas{display:block;width:100%;height:100%;cursor:crosshair;}
</style></head>
<body><canvas id="c"></canvas>
<script>
const c=document.getElementById('c'),x=c.getContext('2d');
let W,H,dpr=window.devicePixelRatio||1;
function size(){W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);}
size();addEventListener('resize',size);

// iridescent palette: ice blue, electric blue, violet, pearl pink
const pal=[[127,214,255],[91,124,255],[167,123,255],[255,158,216]];
const N=140,P=[];
for(let i=0;i<N;i++)P.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,
  r:2+Math.random()*4,ph:Math.random()*6.28,glow:0});

const m={x:-999,y:-999,on:false};
function move(e){const b=c.getBoundingClientRect(),t=e.touches?e.touches[0]:e;m.x=t.clientX-b.left;m.y=t.clientY-b.top;m.on=true;}
c.addEventListener('mousemove',move);c.addEventListener('touchmove',move,{passive:true});
c.addEventListener('mouseleave',()=>m.on=false);c.addEventListener('touchend',()=>m.on=false);

function col(t){ // smooth shift through the palette
  const s=(t%pal.length+pal.length)%pal.length,i=Math.floor(s),f=s-i,a=pal[i],b=pal[(i+1)%pal.length];
  return a.map((v,k)=>Math.round(v+(b[k]-v)*f));
}
let time=0;
function frame(){
  time+=0.005;x.clearRect(0,0,W,H);
  for(const p of P){
    // gentle drift
    p.vx+=Math.sin(time+p.ph)*0.004;p.vy+=Math.cos(time*1.3+p.ph)*0.004;
    // touch: particles are drawn softly toward the hand and bloom
    if(m.on){const dx=m.x-p.x,dy=m.y-p.y,d=Math.hypot(dx,dy);
      if(d<140){p.vx+=dx/d*0.05;p.vy+=dy/d*0.05;p.glow=Math.min(1,p.glow+0.06);}}
    p.glow*=0.97;p.vx*=0.98;p.vy*=0.98;p.x+=p.vx;p.y+=p.vy;
    if(p.x<-20)p.x=W+20;if(p.x>W+20)p.x=-20;if(p.y<-20)p.y=H+20;if(p.y>H+20)p.y=-20;
    const [r,g,b]=col(time*2+p.ph),rad=p.r*(1+p.glow*2.5);
    const gr=x.createRadialGradient(p.x,p.y,0,p.x,p.y,rad*3);
    gr.addColorStop(0,`rgba(${r},${g},${b},${0.55+p.glow*0.45})`);
    gr.addColorStop(1,`rgba(${r},${g},${b},0)`);
    x.fillStyle=gr;x.beginPath();x.arc(p.x,p.y,rad*3,0,6.283);x.fill();
  }
  requestAnimationFrame(frame);
}
frame();
</script></body></html>
